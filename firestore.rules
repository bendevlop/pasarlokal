rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc(uid) { return get(/databases/$(database)/documents/users/$(uid)); }
    function isAdmin() { return signedIn() && userDoc(request.auth.uid).data.role == 'admin'; }
    function isApprovedSeller() { return signedIn() && userDoc(request.auth.uid).data.role == 'seller' && userDoc(request.auth.uid).data.sellerStatus == 'approved'; }

    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role in ['customer', 'seller', 'driver']
        && (request.resource.data.role != 'seller' || request.resource.data.sellerStatus == 'pending');
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.sellerStatus == resource.data.sellerStatus
        && request.resource.data.uid == resource.data.uid);
      allow delete: if isAdmin();
    }

    match /driverPresence/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid
        && userDoc(uid).data.role == 'driver'
        && request.resource.data.uid == uid
        && request.resource.data.online is bool
        && request.resource.data.phone is string;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /sellerApplications/{uid} {
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.status == 'pending';
      // Admin can review all applications; users can read only their own application.
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
          && resource.data.uid == uid
          && resource.data.status == 'rejected'
          && request.resource.data.status == 'pending'
          && request.resource.data.uid == uid);
      allow delete: if isAdmin();
    }

    match /paymentSettings/{settingsId} {
      allow read: if signedIn();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if resource.data.status == 'approved' || isAdmin() || (signedIn() && resource.data.ownerId == request.auth.uid);
      allow create: if (isAdmin() || (isApprovedSeller() && request.resource.data.ownerId == request.auth.uid))
        && request.resource.data.status == 'approved'
        && request.resource.data.price is number && request.resource.data.price > 0;
      allow update, delete: if isAdmin() || (isApprovedSeller() && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.status == resource.data.status);
    }


    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.recipientId == request.auth.uid;
      allow update: if signedIn() && resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']);
      // Pembuatan notifikasi dilakukan backend tepercaya, bukan dari browser pelanggan.
      allow create, delete: if isAdmin();
    }

  match /chats/{chatId} {
      allow create: if signedIn()
        && request.resource.data.customerId is string
        && request.resource.data.sellerId is string
        && (request.auth.uid == request.resource.data.customerId || request.auth.uid == request.resource.data.sellerId)
        && request.resource.data.participants is list
        && request.resource.data.participants.hasAll([request.resource.data.customerId, request.resource.data.sellerId]);
      allow get: if isAdmin() || (signedIn() && (chatId.matches('.*' + request.auth.uid + '.*') || request.auth.uid == resource.data.customerId || request.auth.uid == resource.data.sellerId));
      allow list: if isAdmin() || (signedIn() && (request.auth.uid == resource.data.customerId || request.auth.uid == resource.data.sellerId));
      allow update: if isAdmin() || (signedIn()
        && (request.auth.uid == resource.data.customerId || request.auth.uid == resource.data.sellerId)
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.sellerId == resource.data.sellerId
        && request.resource.data.participants == resource.data.participants);
      allow delete: if isAdmin();

      match /messages/{messageId} {
        function chatDoc() { return get(/databases/$(database)/documents/chats/$(chatId)); }
        function isChatParticipant() {
          return signedIn() && (request.auth.uid == chatDoc().data.customerId || request.auth.uid == chatDoc().data.sellerId);
        }
        allow read: if isChatParticipant() || isAdmin();
        allow create: if (isChatParticipant() || isAdmin())
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.message is string
          && request.resource.data.message.size() > 0
          && request.resource.data.message.size() <= 2000;
        allow update, delete: if false;
      }
    }

    match /orders/{orderId} {
      allow create: if signedIn()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.sellerId is string
        && request.resource.data.productId is string
        && request.resource.data.quantity is int && request.resource.data.quantity > 0
        && request.resource.data.total is number
        && request.resource.data.status == 'Menunggu konfirmasi'
        && get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.status == 'approved'
        && get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.ownerId == request.resource.data.sellerId
        && get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.price == request.resource.data.unitPrice;
      allow read: if isAdmin() || (signedIn() && (
        resource.data.customerId == request.auth.uid
        || resource.data.customerUid == request.auth.uid
        || resource.data.buyerId == request.auth.uid
        || resource.data.userId == request.auth.uid
        || resource.data.sellerId == request.auth.uid
        || resource.data.assignedDriverUid == request.auth.uid
        || resource.data.customerEmail == request.auth.token.email
        || resource.data.email == request.auth.token.email
      ));
      allow update: if isAdmin()
        || (signedIn() && resource.data.assignedDriverUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
          && request.resource.data.status in ['Diproses','Dikirim','Selesai','Dibatalkan'])
        || (signedIn() && resource.data.sellerId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
          && request.resource.data.status in ['Menunggu konfirmasi','Diproses','Dikirim','Selesai','Dibatalkan'])
        || (signedIn() && resource.data.customerId == request.auth.uid
          && resource.data.paymentMethod != 'COD'
          && resource.data.paymentStatus != 'Terverifikasi'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentProofUrl','paymentSubmittedAt','paymentStatus','updatedAt'])
          && request.resource.data.paymentProofUrl is string
          && request.resource.data.paymentProofUrl.size() > 10
          && request.resource.data.paymentStatus == 'Menunggu verifikasi');
      allow delete: if isAdmin();
    }
  }
}
