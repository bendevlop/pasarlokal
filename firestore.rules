rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc(uid) { return get(/databases/$(database)/documents/users/$(uid)); }
    function isAdmin() { return signedIn() && userDoc(request.auth.uid).data.role == 'admin'; }
    function isApprovedSeller() { return signedIn() && userDoc(request.auth.uid).data.role == 'seller' && userDoc(request.auth.uid).data.sellerStatus == 'approved'; }

    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role in ['customer', 'seller']
        && (request.resource.data.role != 'seller' || request.resource.data.sellerStatus == 'pending');
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.sellerStatus == resource.data.sellerStatus
        && request.resource.data.uid == resource.data.uid);
      allow delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if resource.data.status == 'approved' || isAdmin() || (signedIn() && resource.data.ownerId == request.auth.uid);
      allow create: if isApprovedSeller() && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'approved'
        && request.resource.data.price is number && request.resource.data.price > 0;
      allow update, delete: if isAdmin() || (isApprovedSeller() && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.status == resource.data.status);
    }

    match /orders/{orderId} {
      allow create: if signedIn() && request.resource.data.customerId == request.auth.uid;
      allow read: if isAdmin() || (signedIn() && (resource.data.customerId == request.auth.uid || resource.data.sellerId == request.auth.uid));
      allow update: if isAdmin() || (signedIn() && resource.data.sellerId == request.auth.uid);
      allow delete: if isAdmin();
    }
  }
}
